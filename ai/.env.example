# InvestSphere GenAI plane — environment template.
# Copy to `.env` (git-ignored) and fill in, OR inject from Azure Key Vault via the
# Container App's managed identity. Nothing here is required to IMPORT the code or run
# `--dry-run` checks — Azure features are feature-flagged and fall back to deterministic
# custom behavior when unset.

# ---- Azure AI Foundry project ------------------------------------------------
AZURE_AI_PROJECT_ENDPOINT=            # Foundry project endpoint (agent provisioning + Azure evals)
PROJECT_ENDPOINT=                     # alias accepted by ai/foundry/provision_agent.py
AZURE_AI_PROJECT_CONNECTION_STRING=   # or a Foundry project connection string (provision_agent.py)
AZURE_SEARCH_CONNECTION_ID=           # Foundry connection id for the AI Search tool (provision_agent.py)

# ---- Azure OpenAI ------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=                # https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=                 # or use managed identity
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o        # default chat deployment (agent + LLM-judge evaluators)
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# model router deployments (used only when MODEL_ROUTER_ENABLED=true; fall back to AZURE_OPENAI_DEPLOYMENT)
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o-mini      # cheap model for lookups / ops / tool-selection turns
AZURE_OPENAI_DEPLOYMENT_REASONING=gpt-4o      # reasoning model for business synthesis / recommendations
AZURE_OPENAI_MAX_RETRIES=4            # SDK ret/backoff on 429/5xx
AZURE_OPENAI_TIMEOUT=30

# ---- Azure AI Search (RAG) ---------------------------------------------------
AZURE_AI_SEARCH_ENDPOINT=            # https://<search>.search.windows.net  (alias of AZURE_SEARCH_ENDPOINT)
AZURE_SEARCH_ENDPOINT=              # read by ai/rag/retriever.py (same value as above)
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=investsphere-policies

# ---- Azure AI Content Safety — Prompt Shields --------------------------------
AZURE_CONTENT_SAFETY_ENDPOINT=       # https://<contentsafety>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=            # or use managed identity

# ---- Azure AI Language — sentiment enrichment --------------------------------
AZURE_LANGUAGE_ENDPOINT=             # https://<language>.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=                  # or use managed identity

# ---- Application Insights (tracing) ------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Databricks SQL Warehouse (read-only Gold marts) -------------------------
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=investsphere_prod

# ---- Agent runtime -----------------------------------------------------------
AGENT_RUNTIME=raw                    # raw = Azure OpenAI SDK loop (default) | langgraph = real StateGraph
MODEL_ROUTER_ENABLED=false           # true → route fast vs reasoning model by intent (cost/latency)

# ---- Feature flags (default OFF → deterministic custom fallbacks) ------------
EVAL_GATE_ENABLED=false              # true → use Azure AI Evaluation SDK evaluators in the gate
TRACING_ENABLED=false                # true → export OpenTelemetry spans to Application Insights
PROMPT_SHIELDS_ENABLED=false         # true → live Content Safety Prompt Shields in the input guard
SENTIMENT_ENRICHMENT_ENABLED=false   # true → Azure AI Language sentiment (else deterministic lexicon)
LIVE_GROUNDEDNESS_ENABLED=false      # true → score a SAMPLE of live answers for groundedness (hallucination rate)
LIVE_GROUNDEDNESS_SAMPLE_RATE=0.10   # fraction of live requests scored (0.10 = 10%)

# ---- Optional MCP action tools (ai/mcp/) -------------------------------------
MCP_ENABLE_ACTIONS=false             # action tools stay approval-gated even when true

# ---- [6] Foundry IQ agentic retrieval (ai/benchmarks/) -----------------------
AGENTIC_RETRIEVAL_ENABLED=false      # true → Azure AI Search knowledge agent (agentic retrieval)
AZURE_SEARCH_AGENT=investsphere-knowledge-agent   # the knowledge-agent name on the Search service

# ---- [7] Document Intelligence reconciliation (ai/docintel/) -----------------
DOC_INTEL_ENABLED=false              # true → call Azure AI Document Intelligence
AZURE_DOC_INTEL_ENDPOINT=            # https://<docintel>.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=                 # or managed identity

# ---- [9] Responsible-AI red-team (ai/redteam/) -------------------------------
REDTEAM_SIMULATOR_ENABLED=false      # true → azure-ai-evaluation AdversarialSimulator (needs AZURE_AI_PROJECT)

# ---- [10] Arabic bilingual retrieval (ai/i18n/) ------------------------------
# Use a cross-lingual embedding deployment for AR/EN parity:
#   AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# ---- [12] Microsoft Teams publishing (ai/integrations/teams/) ----------------
TEAMS_ENABLED=false                  # true → POST Adaptive Cards to the channel
TEAMS_WEBHOOK_URL=                   # Teams channel Incoming Webhook URL
