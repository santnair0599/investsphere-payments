{
  "openapi": "3.0.3",
  "info": {
    "title": "InvestSphere Business Marts Tools",
    "version": "1.0.0",
    "description": "Governed KPI/risk queries over Databricks Gold marts, exposed as OpenAPI operations for the Azure AI Foundry agent. Generated from ai/tools/business_tools.TOOL_SPECS \u2014 do not edit by hand; run `python -m ai.foundry.build_openapi_tools`."
  },
  "servers": [
    {
      "url": "https://REPLACE_WITH_CONTAINER_APP_FQDN",
      "description": "Azure Container App ingress (FastAPI)."
    }
  ],
  "paths": {
    "/tools/get_underperforming_properties": {
      "post": {
        "operationId": "get_underperforming_properties",
        "summary": "Real-estate assets with falling occupancy and/or rising maintenance cost.",
        "description": "Real-estate assets with falling occupancy and/or rising maintenance cost.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "period": {
                    "type": "string",
                    "enum": [
                      "last_30_days",
                      "last_month",
                      "last_week",
                      "this_month",
                      "this_week"
                    ],
                    "description": "Reporting period window. Omit to use the tool default.",
                    "example": "this_week"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured rows from the governed Gold mart.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mart": {
                      "type": "string",
                      "description": "Governed Gold mart the rows came from."
                    },
                    "row_count": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "managed_identity": []
          }
        ]
      }
    },
