# Copy to ~/.dbt/profiles.yml and fill in. Gold runs against a Databricks SQL
# warehouse; the token comes from a secret, never hardcode it here in real use.
investsphere_payments:
  target: dev
  outputs:
    dev:
      type: databricks
      catalog: investsphere
      schema: gold
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 4
